#!/bin/bash
# Run Omarchy on Niri by pointing OMARCHY_PATH at an overlayfs view of the
# packaged runtime: overlay/ (Niri replacements) over patched/ (upstream files
# with small diffs applied) over /usr/share/omarchy, which is never modified.
#
# install    Install dependencies, mount the view, register the session, set up ~/.config/niri
# update     Copy this checkout over the installed copy, then rebuild
# rebuild    Re-apply patches against the current package and remount (pacman hook)
# uninstall  Unmount and restore every system file this script wrote
# status     Show mount state and any patch failures
# notify     Desktop notification when setup or an update is due (run by the shell plugin)
set -euo pipefail

HERE=$(cd -- "$(dirname -- "$(realpath -- "${BASH_SOURCE[0]}")")" && pwd)
PREFIX=${OMARCHY_NIRI_PREFIX:-/usr/local/lib/omarchy-niri}
STATE=${OMARCHY_NIRI_STATE:-/var/lib/omarchy-niri}
BASE=${OMARCHY_NIRI_BASE:-/usr/share/omarchy}
MOUNT=/run/omarchy/niri
UNIT=run-omarchy-niri.mount
LEDGER=$STATE/ledger
DEPENDENCIES=(niri xwayland-satellite xdg-desktop-portal-gnome xdg-desktop-portal-gtk
  wf-recorder gammastep wl-mirror python git jq slurp grim wl-clipboard)

die() { echo "omarchy-niri-extension: $*" >&2; exit 1; }

# --- ledger: every system file we create is recorded so uninstall can undo it ---
digest() {
  if [[ -L $1 ]]; then echo "link:$(readlink "$1")"
  elif [[ -e $1 ]]; then sha256sum "$1" | cut -c1-64
  else echo none; fi
}
remember() {  # back up the pre-existing file once, before the first write
  grep -qF -- $'\t'"$1" "$LEDGER" 2>/dev/null && return 0
  if [[ -e $1 || -L $1 ]]; then
    mkdir -p "$STATE/backup$(dirname "$1")"
    cp -a "$1" "$STATE/backup$1"
  fi
  printf 'pending\t%s\n' "$1" >>"$LEDGER"
}
record() {
  { grep -vF -- $'\t'"$1" "$LEDGER" || true; printf '%s\t%s\n' "$(digest "$1")" "$1"; } >"$LEDGER.new"
  mv "$LEDGER.new" "$LEDGER"
}
put() {  # put <path> <mode>  (content on stdin)
  local tmp; tmp=$(mktemp)
  cat >"$tmp"
  remember "$1"
  install -Dm"$2" "$tmp" "$1"
  rm -f "$tmp"
  record "$1"
}
link() {  # link <path> <target>
  remember "$1"
  mkdir -p "$(dirname "$1")"
  ln -sfn "$2" "$1"
  record "$1"
}
restore() {  # undo every ledger entry; edits made after us are kept aside, not discarded
  [[ -f $LEDGER ]] || return 0
  local recorded path
  while IFS=$'\t' read -r recorded path; do
    if [[ $(digest "$path") != "$recorded" && -e $path ]]; then
      mkdir -p "$STATE/preserved$(dirname "$path")"
      cp -a "$path" "$STATE/preserved$path"
    fi
    rm -f "$path"
    [[ -e $STATE/backup$path || -L $STATE/backup$path ]] && cp -a "$STATE/backup$path" "$path"
  done <"$LEDGER"
}

# --- the view ---
sync_checkout() {
  [[ $HERE == "$PREFIX" ]] && return 0
  rm -rf "$PREFIX.new"
  cp -a "$HERE" "$PREFIX.new"
  rm -rf "$PREFIX.new/.git" "$PREFIX.old"
  [[ -d $PREFIX ]] && mv "$PREFIX" "$PREFIX.old"
  mv "$PREFIX.new" "$PREFIX"
  rm -rf "$PREFIX.old"
}

remount() {
  [[ -z ${OMARCHY_NIRI_NO_MOUNT:-} ]] || return 0
  systemctl daemon-reload
  # Lazy unmount: processes still running from the old view keep it; new
  # lookups get the rebuilt one at the same path. Overlayfs cannot swap a
  # lower layer in place.
  ! mountpoint -q "$MOUNT" || umount -l "$MOUNT"
  systemctl start "$UNIT"
}

rebuild() {
  local new=$STATE/patched.new patch target failed=()
  rm -rf "$new"
  mkdir -p "$new"
  while IFS= read -r -d '' patch; do
    target=${patch#"$PREFIX/patches/"}
    target=${target%.patch}
    # -L materializes the package's command symlinks so the patch lands on a copy.
    if [[ -e $BASE/$target ]] && mkdir -p "$new/$(dirname "$target")" \
       && cp -L "$BASE/$target" "$new/$target" \
       && (cd "$new" && git apply --include="$target" "$patch" 2>/dev/null); then
      continue
    fi
    # The patch no longer fits the installed Omarchy. Keep the previous
    # rebuild's output for this one file when there is one (last known-good
    # Niri behavior); otherwise the unpatched upstream copy shows through.
    # The rest of the view is unaffected and status names the file.
    [[ ! -f $STATE/patched/$target ]] || cp -p "$STATE/patched/$target" "$new/$target"
    failed+=("$target")
  done < <(find "$PREFIX/patches" -name '*.patch' -print0)
  rm -rf "$STATE/patched.old"
  [[ ! -d $STATE/patched ]] || mv "$STATE/patched" "$STATE/patched.old"
  mv "$new" "$STATE/patched"
  rm -rf "$STATE/patched.old"
  if ((${#failed[@]})); then
    printf '%s\n' "${failed[@]}" >"$STATE/rebuild-failed"
    echo "Patches no longer apply to the installed Omarchy: ${failed[*]}" >&2
  else
    rm -f "$STATE/rebuild-failed"
  fi
  remount
  ((${#failed[@]} == 0))
}

# --- system integration ---
write_system_files() {
  put /etc/systemd/system/$UNIT 644 <<UNIT_EOF
[Unit]
Description=Omarchy runtime with the Niri overlay
Before=display-manager.service

[Mount]
What=overlay
Where=$MOUNT
Type=overlay
Options=lowerdir=$PREFIX/overlay:$STATE/patched:$BASE,ro

[Install]
WantedBy=local-fs.target
UNIT_EOF
  # Same two files omarchy-dev-link writes, so omarchy dev status/unlink stay meaningful.
  local sudoers="Defaults secure_path=\"$MOUNT/bin:/usr/local/sbin:/usr/local/bin:/usr/bin\""
  visudo -cqf <(echo "$sudoers") || die "generated sudoers line is invalid"
  echo "$sudoers" | put /etc/sudoers.d/omarchy-dev-path 440
  echo "export OMARCHY_PATH=\"$MOUNT\"" | put /etc/omarchy.conf 644
  # The remembered "Omarchy" session also starts Niri, so SDDM autologin keeps working.
  put /usr/local/share/wayland-sessions/omarchy-niri.desktop 644 <"$PREFIX/overlay/default/wayland-sessions/omarchy-niri.desktop"
  put /usr/local/share/wayland-sessions/omarchy.desktop 644 <"$PREFIX/overlay/default/wayland-sessions/omarchy-niri.desktop"
  printf '[Autologin]\nSession=omarchy-niri.desktop\n' | put /etc/sddm.conf.d/90-omarchy-niri.conf 644
  # Upstream's PreTransaction hook talks to hyprctl; a failure there would abort upgrades.
  link /etc/pacman.d/hooks/10-omarchy-hyprland-reload-pause.hook /dev/null
  link /etc/pacman.d/hooks/90-omarchy-hyprland-reload-resume.hook /dev/null
  put /etc/pacman.d/hooks/95-omarchy-niri.hook 644 <<'HOOK_EOF'
[Trigger]
Operation = Upgrade
Type = Package
Target = omarchy
Target = try-omarchy-runtime

[Action]
Description = Re-applying the Niri overlay patches...
When = PostTransaction
Exec = /usr/local/bin/omarchy-niri-extension rebuild
HOOK_EOF
  link /usr/local/bin/omarchy-niri-extension "$PREFIX/omarchy-niri-extension"
}

as_user() {
  runuser -u "$USER_NAME" -- env HOME="$USER_HOME" OMARCHY_PATH="$MOUNT" \
    PATH="$MOUNT/bin:/usr/local/bin:/usr/bin" XDG_RUNTIME_DIR="/run/user/$USER_UID" "$@"
}

configure_user() {
  local dir=$USER_HOME/.config/niri name
  install -d -o "$USER_UID" -g "$USER_GID" "$dir" "$USER_HOME/.config/omarchy"
  put "$dir/config.kdl" 644 <"$PREFIX/overlay/config/niri/config.kdl"
  chown "$USER_UID:$USER_GID" "$dir/config.kdl"
  # Personal files: created once, never tracked, never removed.
  for name in input outputs bindings; do
    [[ -e $dir/$name.kdl ]] || echo '// Personal Niri overrides.' | install -m644 -o "$USER_UID" -g "$USER_GID" /dev/stdin "$dir/$name.kdl"
  done
  [[ -e $USER_HOME/.config/omarchy/niri-style.json ]] \
    || install -m644 -o "$USER_UID" -g "$USER_GID" "$PREFIX/overlay/config/omarchy/niri-style.json" "$USER_HOME/.config/omarchy/niri-style.json"
  as_user omarchy-niri theme
  as_user niri validate --config "$dir/config.kdl"
}

install_extension() {
  [[ -n $USER_NAME ]] || die "run with sudo from your desktop account, or pass --user NAME"
  [[ $USER_UID != 0 ]] || die "--user must be the desktop account, not root"
  [[ ! -f $LEDGER ]] || die "already installed; use update"
  for name in bin shell default config; do
    [[ -d $BASE/$name ]] || die "$BASE is not an Omarchy runtime (missing $name)"
  done
  if [[ -z ${OMARCHY_NIRI_SKIP_PACKAGES:-} ]]; then
    OMARCHY_PATH=$BASE PATH="$BASE/bin:$PATH" "$BASE/bin/omarchy-pkg-add" "${DEPENDENCIES[@]}"
  fi
  mkdir -p "$STATE"
  trap 'echo "install failed; restoring" >&2; restore; umount -l "$MOUNT" 2>/dev/null || true; rm -rf "$STATE" "$PREFIX"' ERR
  sync_checkout
  write_system_files
  rebuild
  systemctl enable "$UNIT"
  [[ -e /etc/pam.d/omarchy-lock-password ]] \
    || OMARCHY_INSTALL_USER=$USER_NAME OMARCHY_PATH=$MOUNT PATH="$MOUNT/bin:$PATH" omarchy-apply-lock
  configure_user
  trap - ERR
  echo "Installed. Log out and select Omarchy (Niri), or reboot. Undo: sudo omarchy-niri-extension uninstall"
}

uninstall_extension() {
  [[ -f $LEDGER ]] || die "not installed"
  systemctl disable "$UNIT" 2>/dev/null || true
  ! mountpoint -q "$MOUNT" || umount -l "$MOUNT"
  restore
  systemctl daemon-reload
  rm -rf "$PREFIX"
  local archive="$STATE-uninstalled-$(date +%s)"
  mv "$STATE" "$archive"
  echo "Original session restored; reboot. Backups and any preserved edits: $archive"
}

notify() {
  local wanted; wanted=$(jq -r .version "$HERE/manifest.json")
  local run="omarchy-launch-floating-terminal-with-presentation"
  # Root runs this checkout's script: the same trust omarchy plugin enable and
  # omarchy dev link already extend to user-owned code.
  if [[ ! -f $PREFIX/manifest.json ]]; then
    omarchy-notification-send "Omarchy Niri" "Click to set up the Niri session, then log out" \
      --exec "$run" "sudo $(printf %q "$HERE/omarchy-niri-extension") install"
  elif [[ $(jq -r .version "$PREFIX/manifest.json") != "$wanted" ]]; then
    omarchy-notification-send "Omarchy Niri $wanted" "Click to update the installed Niri session" \
      --exec "$run" "sudo $(printf %q "$HERE/omarchy-niri-extension") update"
  fi
}

status() {
  if mountpoint -q "$MOUNT" 2>/dev/null; then echo "overlay: mounted at $MOUNT"; else echo "overlay: not mounted"; fi
  [[ ! -f /etc/omarchy.conf ]] || cat /etc/omarchy.conf
  [[ ! -f $PREFIX/manifest.json ]] || echo "installed: $(jq -r .version "$PREFIX/manifest.json"), this checkout: $(jq -r .version "$HERE/manifest.json")"
  [[ ! -f $STATE/rebuild-failed ]] || { echo "patches not applied:"; cat "$STATE/rebuild-failed"; return 1; }
}

ACTION=${1:-}; shift || true
USER_NAME=${SUDO_USER:-}
while (($#)); do
  case $1 in
    --user) USER_NAME=$2; shift 2 ;;
    *) die "unknown option: $1" ;;
  esac
done
if [[ -n $USER_NAME ]]; then
  USER_UID=$(id -u "$USER_NAME"); USER_GID=$(id -g "$USER_NAME")
  USER_HOME=$(getent passwd "$USER_NAME" | cut -d: -f6)
fi

case $ACTION in
  status) status ;;
  notify) notify ;;
  install|update|rebuild|uninstall)
    # Root is for the mount and system paths; tests redirect both and skip the mount.
    ((EUID == 0)) || [[ -n ${OMARCHY_NIRI_NO_MOUNT:-} ]] || die "run with sudo"
    case $ACTION in
      install) install_extension ;;
      update) [[ -f $LEDGER ]] || die "not installed; use install"; sync_checkout; rebuild ;;
      rebuild) rebuild ;;
      uninstall) uninstall_extension ;;
    esac ;;
  *) sed -n '2,11p' "$0" | sed 's/^# \{0,1\}//'; exit 1 ;;
esac
